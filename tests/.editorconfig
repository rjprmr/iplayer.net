# Suppress analysis rules that conflict with test naming conventions
[*.cs]
# CA1707: Identifiers should not contain underscores - standard convention for test methods
dotnet_diagnostic.CA1707.severity = none
# CA2201: Do not raise reserved exception types - acceptable in test code
dotnet_diagnostic.CA2201.severity = none
# CA1869: Cache and reuse JsonSerializerOptions - acceptable in test code
dotnet_diagnostic.CA1869.severity = none
# CA1816: Call GC.SuppressFinalize - not needed in test disposal
dotnet_diagnostic.CA1816.severity = none
# CA1861: Prefer static readonly fields over constant array arguments - acceptable in test code
dotnet_diagnostic.CA1861.severity = none
