@page
@model GetIPlayer.Web.Pages.Pvr.AddModel
@{
    ViewData["Title"] = "Add PVR Search";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Pvr/Index">PVR</a></li>
        <li class="breadcrumb-item active" aria-current="page">Add Search</li>
    </ol>
</nav>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" name="name"
                               value="@Model.Name" placeholder="e.g. My Favourite Show" required />
                        <div class="form-text">A unique name to identify this PVR search.</div>
                    </div>

                    <div class="mb-3">
                        <label for="searchTerm" class="form-label">Search Term <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="searchTerm" name="searchTerm"
                               value="@Model.SearchTerm" placeholder="e.g. Doctor Who" required />
                        <div class="form-text">The programme name or keyword to search for.</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="typeFilter" class="form-label">Programme Type</label>
                            <select class="form-select" id="typeFilter" name="typeFilter">
                                <option value="">All Types</option>
                                <option value="tv" selected="@(Model.TypeFilter == "tv" ? "selected" : null)">TV</option>
                                <option value="radio" selected="@(Model.TypeFilter == "radio" ? "selected" : null)">Radio</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="channelFilter" class="form-label">Channel Filter</label>
                            <input type="text" class="form-control" id="channelFilter" name="channelFilter"
                                   value="@Model.ChannelFilter" placeholder="e.g. BBC Two" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="outputDirectory" class="form-label">Output Directory</label>
                        <input type="text" class="form-control" id="outputDirectory" name="outputDirectory"
                               value="@Model.OutputDirectory" placeholder="Leave blank for default" />
                        <div class="form-text">Custom download directory for this search (optional).</div>
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="downloadSubtitles"
                               name="downloadSubtitles" value="true" @(Model.DownloadSubtitles ? "checked" : "") />
                        <label class="form-check-label" for="downloadSubtitles">Download subtitles</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Create PVR Search</button>
                        <a asp-page="/Pvr/Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
