@page
@model GetIPlayer.Web.Pages.History.IndexModel
@{
    ViewData["Title"] = "Download History";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex gap-3 align-items-center">
        <p class="mb-0 text-muted">
            <strong>@Model.Records.Count</strong> record(s)
        </p>
        <input type="text" id="filterInput" class="form-control form-control-sm" style="width: 200px"
               placeholder="Filter history..." />
    </div>
    @if (Model.Records.Count > 0)
    {
        <form method="post" asp-page-handler="Clear">
            <button type="submit" class="btn btn-outline-danger btn-sm"
                    onclick="return confirm('Clear all download history? This cannot be undone.')">
                &#128465; Clear History
            </button>
        </form>
    }
</div>

@if (Model.Records.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="historyTable">
            <thead>
                <tr>
                    <th style="width: 70px"></th>
                    <th>Name</th>
                    <th>Episode</th>
                    <th>Type</th>
                    <th>Channel</th>
                    <th>Mode</th>
                    <th>Size</th>
                    <th>Duration</th>
                    <th>Downloaded</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(record.ThumbnailUrl))
                            {
                                <img src="@record.ThumbnailUrl" alt="" class="rounded"
                                     style="width: 60px; height: 34px; object-fit: cover;" loading="lazy" />
                            }
                        </td>
                        <td>
                            <a asp-page="/Programme" asp-route-pid="@record.Pid"
                               class="text-decoration-none fw-semibold">@record.Name</a>
                        </td>
                        <td class="text-muted">@record.Episode</td>
                        <td>
                            <span class="badge @(record.Type == GetIPlayer.Core.Enums.ProgrammeType.Tv ? "badge-tv" : "badge-radio")">
                                @record.Type
                            </span>
                        </td>
                        <td>@record.Channel</td>
                        <td><code>@record.Mode</code></td>
                        <td>@FormatBytes(record.FileSize)</td>
                        <td>
                            @if (record.Duration > TimeSpan.Zero)
                            {
                                @record.Duration.ToString(@"h\:mm\:ss")
                            }
                        </td>
                        <td class="text-muted small">
                            @record.DownloadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <p class="text-muted">No download history yet. Downloaded programmes will appear here.</p>
        <a asp-page="/Search" class="btn btn-primary">Search for programmes</a>
    </div>
}

@section Scripts {
    <script>setupTableFilter('filterInput', 'historyTable');</script>
}

@functions {
    private static string FormatBytes(long bytes)
    {
        return bytes switch
        {
            >= 1073741824 => $"{bytes / 1073741824.0:F2} GB",
            >= 1048576 => $"{bytes / 1048576.0:F1} MB",
            >= 1024 => $"{bytes / 1024.0:F0} KB",
            _ => $"{bytes} B"
        };
    }
}
