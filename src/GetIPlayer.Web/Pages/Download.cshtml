@page
@model DownloadModel
@{
    ViewData["Title"] = "Download";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Quick Download Form -->
<div class="card mb-4">
    <div class="card-header">
        <h6 class="mb-0">Quick Download</h6>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="target" class="form-label">PID, URL, or Index</label>
                    <input type="text" class="form-control" id="target" name="target"
                           value="@Model.Target" placeholder="e.g. b0000001 or https://www.bbc.co.uk/iplayer/..." autofocus />
                </div>
                <div class="col-md-6 d-flex align-items-end gap-4">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="subtitles" name="subtitles" value="true" />
                        <label class="form-check-label" for="subtitles">Subtitles</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="force" name="force" value="true" />
                        <label class="form-check-label" for="force">Force</label>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="overwrite" name="overwrite" value="true" />
                        <label class="form-check-label" for="overwrite">Overwrite</label>
                    </div>
                    <button type="submit" class="btn btn-success ms-auto">
                        &#11015; Download
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Active Downloads -->
<h5 class="mb-3">Active Downloads <span class="badge bg-primary">@Model.ActiveDownloads.Count</span></h5>

@if (Model.ActiveDownloads.Count > 0)
{
    <div class="row g-3 mb-4" id="activeDownloads">
        @foreach (var dl in Model.ActiveDownloads)
        {
            <div class="col-12" id="download-@dl.DownloadId">
                <div class="card download-progress">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-1">
                            <strong>@dl.Pid</strong>
                            <span class="text-muted small">@dl.Phase</span>
                        </div>
                        <div class="progress mb-1">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar"
                                 style="width: @(dl.PercentComplete?.ToString("F0") ?? "0")%"
                                 aria-valuenow="@(dl.PercentComplete ?? 0)" aria-valuemin="0" aria-valuemax="100">
                                @(dl.PercentComplete?.ToString("F1") ?? "0")%
                            </div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small">
                            <span>@FormatBytes(dl.BytesDownloaded) / @FormatBytes(dl.TotalBytes)</span>
                            <span>@FormatSpeed(dl.BytesPerSecond)</span>
                            @if (dl.EstimatedTimeRemaining.HasValue)
                            {
                                <span>ETA: @dl.EstimatedTimeRemaining.Value.ToString(@"mm\:ss")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted mb-4">No active downloads.</p>
}

<!-- Recent Completed -->
<h5 class="mb-3">Recent Completed</h5>

@if (Model.RecentCompleted.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>PID</th>
                    <th>Status</th>
                    <th>File</th>
                    <th>Size</th>
                    <th>Completed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dl in Model.RecentCompleted)
                {
                    <tr>
                        <td><code>@dl.Pid</code></td>
                        <td>
                            @{
                                var statusClass = dl.Status switch
                                {
                                    GetIPlayer.Core.Enums.DownloadStatus.Success => "bg-success",
                                    GetIPlayer.Core.Enums.DownloadStatus.Failed => "bg-danger",
                                    GetIPlayer.Core.Enums.DownloadStatus.Skipped => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusClass">@dl.Status</span>
                        </td>
                        <td class="text-truncate" style="max-width: 300px;" title="@dl.FilePath">
                            @(dl.FilePath ?? "—")
                        </td>
                        <td>@FormatBytes(dl.BytesDownloaded)</td>
                        <td class="text-muted">@dl.CompletedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p class="text-muted">No completed downloads yet.</p>
}

@section Scripts {
    <script>
        // Subscribe to active downloads for real-time updates
        (function() {
            const activeIds = [@Html.Raw(string.Join(",", Model.ActiveDownloads.Select(d => $"'{d.DownloadId}'")))];
            activeIds.forEach(function(id) {
                downloadHub.subscribe(id,
                    function(data) { updateProgressBar('download-' + id, data); },
                    function(data) { location.reload(); }
                );
            });
        })();
    </script>
}

@functions {
    private static string FormatBytes(long bytes)
    {
        return bytes switch
        {
            >= 1073741824 => $"{bytes / 1073741824.0:F2} GB",
            >= 1048576 => $"{bytes / 1048576.0:F1} MB",
            >= 1024 => $"{bytes / 1024.0:F0} KB",
            _ => $"{bytes} B"
        };
    }

    private static string FormatSpeed(double bytesPerSecond)
    {
        return bytesPerSecond switch
        {
            >= 1048576 => $"{bytesPerSecond / 1048576.0:F1} MB/s",
            >= 1024 => $"{bytesPerSecond / 1024.0:F0} KB/s",
            _ => $"{bytesPerSecond:F0} B/s"
        };
    }
}
