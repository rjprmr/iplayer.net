<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - get_iplayer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar bg-dark text-white">
            <div class="sidebar-header p-3 border-bottom border-secondary">
                <a class="text-white text-decoration-none fs-5 fw-bold" asp-page="/Index">
                    <span class="sidebar-icon">&#9655;</span> get_iplayer
                </a>
            </div>
            <ul class="nav flex-column p-2">
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")"
                       asp-page="/Index">
                        <span class="sidebar-icon">&#9632;</span> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Search", StringComparison.Ordinal) == true ? "active" : "")"
                       asp-page="/Search">
                        <span class="sidebar-icon">&#128269;</span> Search
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Download", StringComparison.Ordinal) == true ? "active" : "")"
                       asp-page="/Download">
                        <span class="sidebar-icon">&#11015;</span> Download
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Pvr", StringComparison.Ordinal) == true ? "active" : "")"
                       asp-page="/Pvr/Index">
                        <span class="sidebar-icon">&#9200;</span> PVR
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/History", StringComparison.Ordinal) == true ? "active" : "")"
                       asp-page="/History/Index">
                        <span class="sidebar-icon">&#128214;</span> History
                    </a>
                </li>
                <li class="nav-item mt-auto">
                    <a class="nav-link sidebar-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Settings", StringComparison.Ordinal) == true ? "active" : "")"
                       asp-page="/Settings">
                        <span class="sidebar-icon">&#9881;</span> Settings
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main content -->
        <div class="flex-grow-1 d-flex flex-column min-vh-100">
            <!-- Top bar (mobile toggle + breadcrumb area) -->
            <header class="bg-white border-bottom px-3 py-2 d-flex align-items-center">
                <button class="btn btn-sm btn-outline-secondary d-md-none me-2" type="button"
                        onclick="document.getElementById('sidebar').classList.toggle('show')">
                    &#9776;
                </button>
                <h5 class="mb-0 text-muted">@ViewData["Title"]</h5>
            </header>

            <main class="flex-grow-1 p-4">
                @RenderBody()
            </main>

            <footer class="border-top text-muted small p-3 text-center">
                &copy; 2026 get_iplayer &mdash; BBC iPlayer/Sounds Downloader
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
