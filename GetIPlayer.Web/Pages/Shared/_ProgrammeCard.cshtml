@model GetIPlayer.Core.Models.Programme

<div class="card programme-card h-100">
    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
    {
        <img src="@Model.ThumbnailUrl" class="card-img-top" alt="@Model.Name" loading="lazy" />
    }
    else
    {
        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center text-white">
            No image
        </div>
    }
    <div class="card-body">
        <h6 class="card-title mb-1">
            <a asp-page="/Programme" asp-route-pid="@Model.Pid"
               class="text-decoration-none stretched-link">@Model.Name</a>
        </h6>
        @if (!string.IsNullOrEmpty(Model.Episode))
        {
            <p class="card-text text-muted small mb-1">@Model.Episode</p>
        }
        <div class="d-flex justify-content-between align-items-center">
            <span class="badge @(Model.Type == GetIPlayer.Core.Enums.ProgrammeType.Tv ? "badge-tv" : "badge-radio")">
                @Model.Type
            </span>
            @if (!string.IsNullOrEmpty(Model.Channel))
            {
                <span class="text-muted small">@Model.Channel</span>
            }
        </div>
    </div>
</div>
